# Llama-3.3-70B-Instruct-abliterated is the persona/next-turn generator only.
# The counseling responder remains the separately configured Llama-3.1-8B surrogate.
# PCSA Figure 3/Figure 4 and CARES evaluation remain pinned to GPT-4o-mini.
PCSA_GEN_MODEL=huihui-ai/Llama-3.3-70B-Instruct-abliterated
PCSA_GEN_BASE=http://127.0.0.1:8020/v1
PCSA_EVAL_MODEL=gpt-4o-mini-2024-07-18
PCSA_EVAL_BASE=https://api.openai.com/v1
PCSA_JUDGE_MODEL=gpt-4o-mini-2024-07-18
PCSA_JUDGE_BASE=https://api.openai.com/v1

# Keep the currently selected prompt variants explicit in every run.
PCSA_BUILD=clinical_history
PCSA_STRATEGY=escalation
